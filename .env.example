# Copie para .env e preencha com a config do app web do Firebase
# (Console > Configurações do projeto > Seus apps > SDK setup and configuration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Número do WhatsApp que recebe os pedidos (55 + DDD + número, só dígitos).
# O envio pelo WhatsApp está desativado no protótipo (ver src/views/BagView.vue)
VITE_WHATSAPP_NUMBER=
